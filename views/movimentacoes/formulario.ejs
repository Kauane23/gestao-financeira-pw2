
<% const erros = validationErrors(locals.errors); %>
<% const movimentacao = locals.movimentacao || {} %>

<h3 class="mt-5">
    <% if (movimentacao?.id) { %>
        Atualização da Movimentação
    <% } else { %>
        Nova Movimentação
    <% } %>
</h3>

<form action="<%= movimentacao?.id ? `/movimentacoes/${movimentacao.id}/atualizacao` : '/movimentacoes/novo' %>" method="post">

    <% if (erros.all.length) { %>
        <div class="alert alert-danger">
            <h6>Não foi possível salvar a movimentação</h6>
            <ul>
                <% erros.all.forEach(mensagem => { %>
                    <li><%= mensagem %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <div class="form-group mb-3">
        <label for="valor" class="form-label">Valor</label>
        <input type="number" step="0.01" class="form-control"
               name="valor" id="valor"
               value="<%= movimentacao?.valor ?? '' %>"
               placeholder="Informe o valor">
    </div>

    <div class="form-group mb-3">
        <label for="data_movimentacao" class="form-label">Data</label>
        <input type="date" class="form-control"
               name="data_movimentacao" id="data_movimentacao"
               value="<%= movimentacao?.data_movimentacao ?? '' %>">
    </div>

    <div class="form-group mb-3">
        <label for="descricao" class="form-label">Descrição</label>
        <textarea class="form-control" name="descricao"
                  id="descricao" rows="5"
                  placeholder="Descreva a movimentação..."><%= movimentacao?.descricao ?? '' %></textarea>
    </div>

    <div class="form-group mb-3">
        <label for="id_conta_fk" class="form-label">Conta</label>
        <input type="number" class="form-control"
               name="id_conta_fk" id="id_conta_fk"
               value="<%= movimentacao?.id_conta_fk ?? '' %>">
    </div>

    <div class="form-group mb-3">
        <label for="id_categoria_fk" class="form-label">Categoria</label>
        <input type="number" class="form-control"
               name="id_categoria_fk" id="id_categoria_fk"
               value="<%= movimentacao?.id_categoria_fk ?? '' %>">
    </div>

    <div class="form-group mb-3">
        <button type="submit" class="btn btn-primary mr-2">
            Salvar Movimentação
        </button>
        <a href="/movimentacoes" class="btn btn-warning">
            Cancelar
        </a>
    </div>
</form>