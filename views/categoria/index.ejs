<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="h4 mb-0">Categorias</h2>
  <a href="/categorias/novo" class="btn btn-primary">+ Nova categoria</a>
</div>

<% if (listaCategorias.length === 0) { %>
  <div class="alert alert-info">Nenhuma categoria cadastrada ainda.</div>
<% } else { %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>#</th>
        <th>Nome</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% listaCategorias.forEach((categoria) => { %>
        <tr>
          <td><%= categoria.id %></td>
          <td><%= categoria.nome %></td>
          <td class="text-end">
            <a href="/categorias/<%= categoria.id %>/atualizacao" class="btn btn-sm btn-warning">Editar</a>
            <a href="/categorias/<%= categoria.id %>/exclusao" class="btn btn-sm btn-outline-danger">Excluir</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>